# PasaLista configuration. Copy to `.env` and adjust. Never commit `.env`.
# Every value below is a development default; `pnpm dev` and `docker compose up` work without a .env.

# --- API -------------------------------------------------------------------
# development | test | production. In production every variable below is required.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# PostgreSQL 18 connection string.
DATABASE_URL=postgres://pasalista:pasalista@localhost:5432/pasalista

# Public origin of the web app (the browser only talks to this origin; ADR-0004).
PUBLIC_URL=http://localhost:3000

# Session signing secret, at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# The API refuses to start in production with the development default.
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-0000000000

# Reverse proxies you control that APPEND the client address to X-Forwarded-For
# (nginx, Caddy, Traefik). The Next.js rewrite does not count: it forwards the client's
# header unchanged. Use 0 locally and 1 behind a reverse proxy in production (ADR-0006).
# Setting it too high lets clients spoof their IP and bypass rate limits.
# E2E tests need 1 (they simulate several clients through this header).
TRUSTED_PROXY_HOPS=0

RATE_LIMIT_ENABLED=true
EMAIL_WORKER_ENABLED=true

# --- Email (Mailpit in development: http://localhost:8025) ----------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="PasaLista <no-reply@pasalista.localhost>"

# --- Web -------------------------------------------------------------------
# Where the Next.js server reaches the API (also used for the /api rewrite at build time).
API_INTERNAL_URL=http://localhost:3001

# --- Tests -----------------------------------------------------------------
TEST_DATABASE_URL=postgres://pasalista:pasalista@localhost:5432/pasalista_test
# Playwright (pnpm test:e2e) targets a running stack.
E2E_BASE_URL=http://localhost:3000
MAILPIT_URL=http://localhost:8025